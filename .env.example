# Telegram bot credentials
# Real values must be stored in .env / .env.local on the server and must not be committed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram API access from Russia goes through NAS proxy.
# Current production proxy is configured on the server/NAS side.
TELEGRAM_PROXY_HOST=192.168.50.190
TELEGRAM_PROXY_PORT=7890

# Optional generic proxy vars if needed by Docker/runtime.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
